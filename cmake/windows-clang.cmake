set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(M7G_LLVM /workspace/tooling/windows-tools/usr/lib/llvm-19/bin)
set(M7G_SDK /workspace/tooling/msvc-sdk)
set(CMAKE_C_COMPILER ${M7G_LLVM}/clang-cl)
set(CMAKE_CXX_COMPILER ${M7G_LLVM}/clang-cl)
set(CMAKE_LINKER ${M7G_LLVM}/lld-link)
set(CMAKE_AR ${M7G_LLVM}/llvm-lib)
set(CMAKE_RC_COMPILER ${M7G_LLVM}/llvm-rc)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_C_FLAGS_INIT "-vfsoverlay /workspace/tooling/msvc-sdk-overlay.json /imsvc${M7G_SDK}/crt/include /imsvc${M7G_SDK}/sdk/include/ucrt /imsvc${M7G_SDK}/sdk/include/shared /imsvc${M7G_SDK}/sdk/include/um")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/libpath:${M7G_SDK}/crt/lib/x86_64 /libpath:${M7G_SDK}/sdk/lib/um/x86_64 /libpath:${M7G_SDK}/sdk/lib/ucrt/x86_64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded CACHE STRING "Static Microsoft runtime")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH ${M7G_SDK})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_RC_FLAGS_INIT "/I/workspace/tooling/msvc-sdk/sdk/include/um /I/workspace/tooling/msvc-sdk/sdk/include/shared /I/workspace/tooling/msvc-sdk/sdk/include/ucrt")
